{
  "name": "doomsday-ctf-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Server-backed multiplayer/team CTF platform for Avengers: Doomsday CTF",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "db:push": "prisma db push",
    "seed": "tsx prisma/seed.ts",
    "admin:reset": "tsx prisma/reset-admin.ts",
    "bootstrap:render": "tsx prisma/bootstrap-render.ts",
    "verify:render-admin": "tsx prisma/verify-render-admin.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "9.4.0",
    "@fastify/cors": "9.0.1",
    "@fastify/jwt": "8.0.1",
    "@fastify/rate-limit": "9.1.0",
    "@fastify/websocket": "10.0.1",
    "@node-rs/argon2": "1.8.3",
    "@prisma/client": "5.22.0",
    "dotenv": "16.4.5",
    "fastify": "4.28.1",
    "fastify-plugin": "4.5.1",
    "nanoid": "5.0.7",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "22.10.1",
    "prisma": "5.22.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
