# ── Database ────────────────────────────────────────────────
# Pooled PostgreSQL connection used by Prisma for normal runtime queries.
# In production use Neon's POOLED endpoint (host contains "-pooler"), sslmode=require.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/doomsday_ctf?schema=public"

# DIRECT (non-pooled) connection used for Prisma Migrate and for interactive
# transactions (archive+wipe on STOP, solve/submission, team create/join,
# reset/cleanup). PgBouncer transaction-mode pooling breaks interactive
# transactions (P2028 "Transaction not found"), so these run on a session-pinned
# direct connection. In production set this to Neon's DIRECT endpoint (host
# WITHOUT "-pooler"), sslmode=require. Locally it can equal DATABASE_URL
# (localhost has no pooler). If unset, the app falls back to DATABASE_URL.
DIRECT_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/doomsday_ctf?schema=public"

# Separate database used by the automated test suite.
TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/doomsday_ctf_test?schema=public"

# ── Server ──────────────────────────────────────────────────
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# ── Secrets (CHANGE THESE — never commit real values) ───────
# Use long random strings, e.g. `openssl rand -hex 32`
JWT_SECRET=replace-with-a-long-random-string-min-32-chars
COOKIE_SECRET=replace-with-another-long-random-string

# Access token lifetime (seconds). Default 8h.
JWT_EXPIRES_IN=28800

# ── CORS origins (comma separated, no trailing slash) ───────
PLAYER_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174

# Set to "true" only when serving over HTTPS in production.
COOKIE_SECURE=false
# Session cookie SameSite: "lax" (default, same-site) | "strict" | "none".
# For cross-site production (player/admin on a different domain than the API),
# set COOKIE_SAMESITE=none AND COOKIE_SECURE=true (requires HTTPS).
COOKIE_SAMESITE=lax

# ── Seed admin account (created by prisma/seed.ts) ──────────
# The admin is created/updated from these values by `npm run seed`.
# If you change ADMIN_PASSWORD later (or forget it), run `npm run admin:reset`
# to deterministically set the admin password hash from ADMIN_PASSWORD.
ADMIN_EMAIL=admin@doomsday.ctf
ADMIN_PASSWORD=ChangeMe_Admin123!
ADMIN_NAME=Doctor Doom

# ── Event / CTF name ────────────────────────────────────────
EVENT_NAME=Avengers: Doomsday CTF

# ── Challenge artifact origin ───────────────────────────────
# Public origin used to build webverse/OSINT challenge artifact URLs embedded in
# clues. Defaults to the local API (http://localhost:PORT). In production set
# this (or PUBLIC_API_URL) to the deployed API origin, then RE-RUN `npm run seed`
# so the seeded clues point at the correct host. Frontends build their own
# artifact URLs from VITE_API_URL at build time.
# PUBLIC_API_URL=https://your-api.example.com
# ARTIFACT_BASE_URL=https://your-api.example.com

# ── Scoring: configurable time-decay policy ─────────────────
# Awarded = max(base * (1 - DECAY_STEP_PERCENT/100 * floor(elapsed/step)), base * FLOOR_PERCENT/100)
SCORING_DECAY_STEP_MINUTES=15
SCORING_DECAY_STEP_PERCENT=10
SCORING_FLOOR_PERCENT=25

# ── Hidden level ────────────────────────────────────────────
HIDDEN_REWARD=500
HIDDEN_PENALTY=400
# Fixed delay (minutes) after CTF start when the hidden level activates for all
# teams simultaneously. At activation the server picks exactly one random member
# per team. Default 30 (T+30).
HIDDEN_LEVEL_DELAY_MINUTES=30

# ── Submission rate limiting ────────────────────────────────
SUBMIT_RATE_MAX=10
SUBMIT_RATE_WINDOW_SECONDS=60
