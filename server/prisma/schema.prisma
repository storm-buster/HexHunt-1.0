// Prisma schema — HexHunt 1.0 (session-based CTF)
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations/introspection run over the DIRECT (non-pooled) connection; a
  // PgBouncer pooled endpoint is not reliable for DDL/advisory locks. Falls
  // back to DATABASE_URL in environments where that var is unset (handled by
  // tooling that passes DIRECT_DATABASE_URL=DATABASE_URL when no pooler exists).
  directUrl = env("DIRECT_DATABASE_URL")
}

enum Role {
  PLAYER
  ADMIN
}

enum TeamRole {
  OWNER
  MEMBER
}

enum SessionStatus {
  LIVE
  COMPLETED
}

enum SubmissionResult {
  CORRECT
  INCORRECT
  DUPLICATE
  REJECTED
}

// ── Users (persistent across sessions) ──────────────────────
model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(PLAYER)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  membership        TeamMembership?
  submissions       Submission[]
  hiddenResults     HiddenLevelResult[]
  hiddenAssignments HiddenLevelAssignment[]

  @@index([email])
}

// ── Teams (persistent across sessions) ──────────────────────
model Team {
  id         String   @id @default(cuid())
  name       String   @unique
  inviteCode String   @unique
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id])

  memberships       TeamMembership[]
  solves            Solve[]
  submissions       Submission[]
  hiddenResults     HiddenLevelResult[]
  hiddenAssignments HiddenLevelAssignment[]

  @@index([eventId])
}

// A user can belong to only ONE team: enforced by @unique on userId.
model TeamMembership {
  id       String   @id @default(cuid())
  teamId   String
  userId   String   @unique
  role     TeamRole @default(MEMBER)
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
}

// ── Event (persistent container; one per deployment) ────────
model Event {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teams    Team[]
  sessions EventSession[]
}

// ── SessionArchive (immutable historical snapshot) ──────────
// Written once at STOP, BEFORE the live participant/gameplay tables are wiped.
// Completely independent of User/Team/EventSession (no FKs), so the live reset
// cannot affect it. `data` holds the full session dataset used for admin-only
// ZIP export; the scalar columns support the history listing. NEVER contains
// password hashes, tokens, flags, or answers. Never updated after creation.
model SessionArchive {
  id               String   @id @default(cuid())
  sessionNumber    Int      @unique
  eventName        String
  startedAt        DateTime
  completedAt      DateTime
  durationSeconds  Int
  numberOfUsers    Int
  numberOfTeams    Int
  totalSolves      Int
  totalSubmissions Int
  highestScore     Int
  hiddenAttempts   Int
  hiddenCorrect    Int
  hiddenIncorrect  Int
  data             Json
  createdAt        DateTime @default(now())

  @@index([sessionNumber])
}

// ── EventSession (one START→STOP run) ───────────────────────
// Each START creates a new session; STOP marks it COMPLETED (archived). All
// gameplay is scoped to a session. Only ONE LIVE session may exist per event
// (enforced by a partial unique index added in the migration).
model EventSession {
  id                 String        @id @default(cuid())
  eventId            String
  sessionNumber      Int
  status             SessionStatus @default(LIVE)
  startedAt          DateTime      @default(now())
  completedAt        DateTime?
  // Hidden-level activation is scheduled server-side at session start.
  hiddenActivationAt DateTime?
  hiddenActivated    Boolean       @default(false)
  createdAt          DateTime      @default(now())

  event             Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  solves            Solve[]
  submissions       Submission[]
  hiddenResults     HiddenLevelResult[]
  hiddenAssignments HiddenLevelAssignment[]

  @@unique([eventId, sessionNumber])
  @@index([eventId])
  @@index([status])
}

// ── Challenge (persistent definitions) ──────────────────────
model Challenge {
  id          String  @id // e.g. "wv-01"
  title       String
  category    String
  universe    String
  difficulty  String
  description String
  narrative   String
  hints       Json
  portalType  String
  portalPuzzle Json
  clueContent Json?
  type        String
  stone       String
  points      Int
  author      String

  nextChallengeId String?
  orderIndex      Int
  universeOrder   Int

  // Secrets — NEVER serialized to players
  flagHash        String
  portalAnswerHash String?
  revealText String?

  isHidden       Boolean @default(false)
  hiddenReward   Int?
  hiddenPenalty  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  solves      Solve[]
  submissions Submission[]

  @@index([universe])
  @@index([isHidden])
}

// ── Solve (team-wide, one per team per challenge PER SESSION) ─
model Solve {
  id             String   @id @default(cuid())
  sessionId      String
  teamId         String
  challengeId    String
  solvedByUserId String
  solvedAt       DateTime @default(now())

  basePoints     Int
  awardedPoints  Int
  elapsedSeconds Int

  session   EventSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  team      Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  challenge Challenge    @relation(fields: [challengeId], references: [id])

  // A challenge can be solved once per team PER SESSION (re-solvable next session).
  @@unique([sessionId, teamId, challengeId])
  @@index([sessionId])
  @@index([teamId])
  @@index([challengeId])
  @@index([sessionId, teamId])
}

// ── Submission audit log (every attempt, per session) ───────
model Submission {
  id            String           @id @default(cuid())
  sessionId     String
  teamId        String
  userId        String
  challengeId   String
  result        SubmissionResult
  awardedPoints Int              @default(0)
  penaltyPoints Int              @default(0)
  submittedAt   DateTime         @default(now())
  ip            String?

  session   EventSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  team      Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge    @relation(fields: [challengeId], references: [id])

  @@index([sessionId])
  @@index([teamId])
  @@index([challengeId])
  @@index([submittedAt])
  @@index([sessionId, teamId])
}

// ── Hidden-level result (one attempt per team PER SESSION) ───
model HiddenLevelResult {
  id                String   @id @default(cuid())
  sessionId         String
  teamId            String
  submittedByUserId String
  correct           Boolean
  scoreDelta        Int
  submittedAt       DateTime @default(now())

  session EventSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  team    Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [submittedByUserId], references: [id], onDelete: Cascade)

  @@unique([sessionId, teamId])
  @@index([sessionId])
}

// ── Hidden-level per-team member assignment (per session) ───
model HiddenLevelAssignment {
  id             String   @id @default(cuid())
  sessionId      String
  teamId         String
  selectedUserId String
  activatedAt    DateTime @default(now())
  createdAt      DateTime @default(now())

  session EventSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  team    Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [selectedUserId], references: [id], onDelete: Cascade)

  @@unique([sessionId, teamId])
  @@index([sessionId])
}
